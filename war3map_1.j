local integer i
set i=1
loop
exitwhen i>GJ
if FJ[i]<SOI then
if EJ[i]==null or IsTriggerEnabled(EJ[i])==true then
call NUI()
else
call DestroyTrigger(EJ[i])
endif
call SII(i)
else
set i=i+1
endif
endloop
return false
endfunction
