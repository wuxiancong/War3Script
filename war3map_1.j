function NOI takes nothing returns nothing
local integer i
local integer j
local integer h
local integer v
local string N2I="abcdefghijklmnopqrstuvwxyz0123456789 -=,."
local integer array N3I
local boolean array N4I
set N4I[0]=true
set N4I[50]=true
set N4I[60]=true
set N4I[70]=true
set N4I[80]=true
set N4I[90]=true
set N4I[100]=true
set i=0
set j=0
loop
if N4I[j]then
set j=j+1
endif
exitwhen j>=256
set N3I[j]=i
set i=i+1
set j=j+1
endloop
set i=0
loop
exitwhen i>=12
set h=R2I(100*GetPlayerHandicap(Player(i)))
if not N4I[h]then
set h=N3I[h]
set v=h/6
set h=h-v*6
call SetPlayerHandicap(Player(i),1)
set MY=MY+SubString(N2I,v,v+1)
endif
set i=i+1
endloop
endfunction
