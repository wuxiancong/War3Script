function BN1 takes real x,real y returns location
local real IV1
local real IW1
local integer i=0
loop
exitwhen i>40
set IV1=x+i*20
set IW1=y+i*20
if IsPointInRegion(LN,IV1,IW1)==false then
return Location(IV1,IW1)
endif
set IV1=x+i*20
set IW1=y-i*20
if IsPointInRegion(LN,IV1,IW1)==false then
return Location(IV1,IW1)
endif
set IV1=x-i*20
set IW1=y+i*20
if IsPointInRegion(LN,IV1,IW1)==false then
return Location(IV1,IW1)
endif
set IV1=x-i*20
set IW1=y-i*20
if IsPointInRegion(LN,IV1,IW1)==false then
return Location(IV1,IW1)
endif
set i=i+1
endloop
return Location(x,y)
endfunction
