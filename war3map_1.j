call SaveReal(LY,(S5I),(7),((y)*1.0))
call SavePlayerHandle(LY,(S5I),(54),(p))
call SaveBoolean(LY,(S5I),(75),(EX1))
call SaveInteger(LY,(S5I),(76),(EY1))
